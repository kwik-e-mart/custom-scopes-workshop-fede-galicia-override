#!/bin/bash
set -euo pipefail

close_failed() {
  np link action update --status failed \
    --messages "$(jq -nc --arg m "$1" '[{level: "error", message: $m}]')" || true
  echo "$1" >&2
  exit 1
}

case "${SERVICE_ACTION_TYPE-}" in
  create) WORKFLOW=link ;;
  update) WORKFLOW=link_update ;;
  delete) WORKFLOW=unlink ;;
  *) close_failed "publisher: acción de link no soportada: type='${SERVICE_ACTION_TYPE-}' slug='${SERVICE_ACTION-}'." ;;
esac

WORKFLOW_PATH="$SERVICE_PATH/workflows/$WORKFLOW.yaml"

SUBSCRIBER_SETTLED_MARKER=$(mktemp)
export SUBSCRIBER_SETTLED_MARKER
trap 'rm -f "$SUBSCRIBER_SETTLED_MARKER"' EXIT

if ! np service workflow exec --workflow "$WORKFLOW_PATH" --build-context; then
  if [ -s "$SUBSCRIBER_SETTLED_MARKER" ]; then
    exit 1
  fi
  close_failed "publisher: el workflow $WORKFLOW falló antes de cerrar la acción del link; revisá el log del agente."
fi
