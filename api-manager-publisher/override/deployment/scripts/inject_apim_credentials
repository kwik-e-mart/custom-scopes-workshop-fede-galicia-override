#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../../../../shared/scripts/provider_env"

load_apim_links() {
  local application_nrn scope_nrn dimensions links
  application_nrn=$(echo "$CONTEXT" | jq -r .application.nrn)
  scope_nrn=$(echo "$CONTEXT" | jq -r .scope.nrn)
  dimensions=$(echo "$CONTEXT" | jq -c '.scope.dimensions // {}')

  if ! links=$(np link list --nrn "$application_nrn" --status active --format json --show_descendants); then
    echo "❌ Failed to list links for $application_nrn" >&2
    exit 1
  fi

  if ! APPLICATION_APIM_LINKS=$(echo "$links" | jq -c --arg provider "$APIM_PUBLISHER_PROVIDER" \
    '(.results? // .) | map(select(.selectors.provider == $provider))'); then
    echo "❌ Failed to read the links of $application_nrn" >&2
    exit 1
  fi
  SCOPE_APIM_LINKS=$(echo "$APPLICATION_APIM_LINKS" | jq -c --arg app "$application_nrn" --arg scope "$scope_nrn" --argjson dims "$dimensions" '
    map(select(
      .entity_nrn == $scope
      or (
        .entity_nrn == $app
        and ([ (.dimensions // {}) | to_entries[] | .value == ($dims[.key]) ] | all)
      )
    ))')
}

load_linked_api_ids() {
  local service_id service api_id
  LINKED_API_IDS=()
  while IFS= read -r service_id; do
    if ! service=$(np service read --id "$service_id" --format json); then
      echo "❌ Failed to read the $APIM_PUBLISHER_PROVIDER service $service_id linked to this application" >&2
      exit 1
    fi
    api_id=$(echo "$service" | jq -r '.attributes.api_id // empty')
    if [ -z "$api_id" ]; then
      echo "⚠️ The $APIM_PUBLISHER_PROVIDER service $service_id has no api_id yet: its API is not published"
      continue
    fi
    if [[ ! "$api_id" =~ ^[A-Za-z0-9]([-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$ ]]; then
      echo "⚠️ The $APIM_PUBLISHER_PROVIDER service $service_id has an api_id that is not a label value: '$api_id'"
      continue
    fi
    LINKED_API_IDS+=("$api_id")
  done < <(echo "$APPLICATION_APIM_LINKS" | jq -r '[.[].service_id // empty] | unique[]')
}

load_subscription_credentials() {
  local api_id secrets
  SUBSCRIPTION_CREDENTIALS='[]'
  for api_id in ${LINKED_API_IDS[@]+"${LINKED_API_IDS[@]}"}; do
    if ! secrets=$(kubectl get secret -n "$APIM_CREDENTIALS_NAMESPACE" -l "consumer-ns=$CREDENTIAL_NAMESPACE,api-id=$api_id" -o json); then
      echo "❌ Failed to read the credential of $api_id for $CREDENTIAL_NAMESPACE in $APIM_CREDENTIALS_NAMESPACE" >&2
      exit 1
    fi
    if [ "$(echo "$secrets" | jq '[.items[] | select((.metadata.labels["app-id"] // "") != "" and (.data.api_key // "") != "")] | length')" -eq 0 ]; then
      echo "⚠️ $APIM_CREDENTIALS_NAMESPACE has no credential for $CREDENTIAL_NAMESPACE on $api_id"
    fi
    SUBSCRIPTION_CREDENTIALS=$({ echo "$SUBSCRIPTION_CREDENTIALS"; echo "$secrets"; } | jq -sc '
      .[0] + [.[1].items[] | {api_id: .metadata.labels["api-id"], app_id: (.metadata.labels["app-id"] // ""), api_key: (.data.api_key // "")}
                | select(.app_id != "" and .api_key != "")]')
  done
}

forget_application_credential() {
  if ! kubectl delete secret "$APIM_CREDENTIAL_SECRET" -n "$CREDENTIAL_NAMESPACE" --ignore-not-found >/dev/null; then
    echo "⚠️ Could not delete $CREDENTIAL_NAMESPACE/$APIM_CREDENTIAL_SECRET; it stays until the next deploy"
  fi
}

save_application_credential() {
  if ! echo "$SUBSCRIPTION_CREDENTIALS" | jq -c --arg name "$APIM_CREDENTIAL_SECRET" --arg ns "$CREDENTIAL_NAMESPACE" --arg app "$APPLICATION_ID" '
    first | {apiVersion: "v1", kind: "Secret", type: "Opaque",
      metadata: {name: $name, namespace: $ns,
        labels: {"app.kubernetes.io/managed-by": "nullplatform", "nullplatform.com/application-id": $app}},
      data: {app_id: (.app_id | @base64), app_key: .api_key}}' \
    | kubectl apply --server-side --field-manager=nullplatform-apim-credentials --force-conflicts -f - >/dev/null; then
    echo "❌ Failed to save the $APIM_PUBLISHER_PROVIDER credential in $CREDENTIAL_NAMESPACE/$APIM_CREDENTIAL_SECRET" >&2
    exit 1
  fi
}

inject_apim_credentials() {
  APPLICATION_ID=$(echo "$CONTEXT" | jq -r '.application.id // empty')
  CREDENTIAL_NAMESPACE=$(echo "$CONTEXT" | jq -r '.providers["container-orchestration"].cluster.namespace // empty')
  if [ -z "$APPLICATION_ID" ] || [ -z "$CREDENTIAL_NAMESPACE" ]; then
    echo "❌ The deployment context has no application.id or container-orchestration namespace" >&2
    exit 1
  fi
  APIM_CREDENTIAL_SECRET="apim-credentials-$APPLICATION_ID"
  local credential_names="APIM_APP_ID, APIM_APP_KEY" distinct

  load_apim_links
  if [ "$(echo "$APPLICATION_APIM_LINKS" | jq 'length')" -eq 0 ]; then
    echo "ℹ️ No $APIM_PUBLISHER_PROVIDER link in this application — skipping $credential_names"
    forget_application_credential
    return 0
  fi
  if [ "$(echo "$SCOPE_APIM_LINKS" | jq 'length')" -eq 0 ]; then
    echo "ℹ️ No $APIM_PUBLISHER_PROVIDER link associated to this scope — skipping $credential_names"
    return 0
  fi

  echo "🔍 $APIM_PUBLISHER_PROVIDER link found — looking for the subscription credential of $CREDENTIAL_NAMESPACE"
  load_linked_api_ids
  load_subscription_credentials

  if [ "$(echo "$SUBSCRIPTION_CREDENTIALS" | jq 'length')" -eq 0 ]; then
    echo "⚠️ $APIM_CREDENTIALS_NAMESPACE has no credential for $CREDENTIAL_NAMESPACE on ${LINKED_API_IDS[*]:-the linked APIs} yet — the deployment goes on without $credential_names"
    return 0
  fi

  distinct=$(echo "$SUBSCRIPTION_CREDENTIALS" | jq '[.[] | {app_id, api_key}] | unique | length')
  if [ "$distinct" -gt 1 ]; then
    echo "⚠️ The APIs linked to this application have different credentials for $CREDENTIAL_NAMESPACE ($(echo "$SUBSCRIPTION_CREDENTIALS" | jq -r 'map("\(.api_id): app-id \(.app_id)") | join(", ")')) — the deployment goes on without $credential_names"
    return 0
  fi

  save_application_credential
  echo "🔑 Saved the credential of $(echo "$SUBSCRIPTION_CREDENTIALS" | jq -r 'map(.api_id) | join(" ")') in $CREDENTIAL_NAMESPACE/$APIM_CREDENTIAL_SECRET — injecting $credential_names"
  inject_provider_env "$APIM_PUBLISHER_PROVIDER credential" "$(jq -nc --arg secret "$APIM_CREDENTIAL_SECRET" '[
    {name: "APIM_APP_ID", type: "secret", value: $secret, key: "app_id"},
    {name: "APIM_APP_KEY", type: "secret", value: $secret, key: "app_key"}]')"
}

inject_apim_credentials
