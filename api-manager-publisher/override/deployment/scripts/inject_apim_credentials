#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../../../../shared/scripts/provider_env"

has_apim_link_for_scope() {
  local application_nrn scope_nrn dimensions links matching
  application_nrn=$(echo "$CONTEXT" | jq -r .application.nrn)
  scope_nrn=$(echo "$CONTEXT" | jq -r .scope.nrn)
  dimensions=$(echo "$CONTEXT" | jq -c '.scope.dimensions // {}')

  if ! links=$(np link list --nrn "$application_nrn" --status active --format json --show_descendants); then
    echo "❌ Failed to list links for $application_nrn" >&2
    exit 1
  fi

  if ! matching=$(echo "$links" | jq \
    --arg provider "$APIM_PUBLISHER_PROVIDER" \
    --arg app "$application_nrn" \
    --arg scope "$scope_nrn" \
    --argjson dims "$dimensions" '
    (.results? // .) | map(select(
      .selectors.provider == $provider
      and (
        .entity_nrn == $scope
        or (
          .entity_nrn == $app
          and ([ (.dimensions // {}) | to_entries[] | .value == ($dims[.key]) ] | all)
        )
      )
    )) | length'); then
    echo "❌ Failed to read the links of $application_nrn" >&2
    exit 1
  fi

  [ "$matching" -gt 0 ]
}

APIM_CREDENTIAL_VARIABLES=$(echo "$APIM_CREDENTIAL_ENV" | yq -o=json -I=0 '.')
APIM_CREDENTIAL_NAMES=$(echo "$APIM_CREDENTIAL_VARIABLES" | jq -r '[.[].name] | join(", ")')

if ! has_apim_link_for_scope; then
  echo "ℹ️ No $APIM_PUBLISHER_PROVIDER link associated to this scope — skipping $APIM_CREDENTIAL_NAMES"
  return 0
fi

echo "🔍 $APIM_PUBLISHER_PROVIDER link found — injecting $APIM_CREDENTIAL_NAMES"
inject_provider_env "$APIM_PUBLISHER_PROVIDER credential" "$APIM_CREDENTIAL_VARIABLES"
