#!/usr/bin/env bash

PUBLISH_TENANT="b2c"
AUTH_POLICY_MANAGED_BY="app.kubernetes.io/managed-by=api-manager-publisher"
AUTH_POLICY_TEMPLATE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/manifests/authpolicy.yaml.tpl"

if ! type -t default_api_id >/dev/null 2>&1; then
default_api_id() {
  local namespace="$1" repository="$2"
  repository=$(echo "${repository%.git}" | tr '[:upper:]' '[:lower:]')
  echo "$namespace-$repository-$PUBLISH_TENANT-1"
}
fi

if ! type -t api_id_is_valid >/dev/null 2>&1; then
api_id_is_valid() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]
}
fi

if ! type -t scope_auth_policy >/dev/null 2>&1; then
scope_auth_policy() {
  local api_id="$1" namespace="$2" scope_id="$3" route="$4"
  jq -nc --arg api_id "$api_id" --arg namespace "$namespace" --arg scope_id "$scope_id" --arg route "$route" '$ARGS.named' \
    | gomplate -c .=stdin:///context.json -f "$AUTH_POLICY_TEMPLATE"
}
fi
