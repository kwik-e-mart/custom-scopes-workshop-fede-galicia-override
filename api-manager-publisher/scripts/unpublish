#!/usr/bin/env bash
set -euo pipefail

UNPUBLISH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$UNPUBLISH_DIR/publisher_lib"

ACTION_SETTLED=0
trap close_on_unexpected_exit EXIT

unpublish() {
  load_notification
  local api_id
  api_id=$(notification_field '.service.attributes.api_id')
  if [ -z "$api_id" ]; then
    close_action success "APIM todavía no tiene endpoint de baja: la API sin apiId sigue publicada. Pedí la baja a APIM por fuera."
    return
  fi
  require_provider_namespace
  detach_scope_auth_policies "$api_id" "$PROVIDER_NAMESPACE"
  close_action success "APIM todavía no tiene endpoint de baja: la API $api_id sigue publicada, pero el scope ya no acepta sus credenciales. Pedí la baja a APIM por fuera."
}

unpublish
