#!/usr/bin/env bash

PUBLISHER_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PUBLISHER_LIB_DIR/subscriber_lib"
source "$PUBLISHER_LIB_DIR/auth_policy"
source "$PUBLISHER_LIB_DIR/../../shared/scripts/application_type"

LEGAJO_PATTERN='^l[0-9]{7}$'
WINDOW_PATTERN='^[0-9]+(ms|s|m|h)$'

require_legajo() {
  local email
  email=$(notification_field '.user.email')
  LEGAJO=$(echo "${email%%@*}" | tr '[:upper:]' '[:lower:]')
  if [ -n "${LEGAJO_OVERRIDE-}" ]; then
    LEGAJO="$LEGAJO_OVERRIDE"
  fi
  if [[ ! "$LEGAJO" =~ $LEGAJO_PATTERN ]]; then
    fail "publisher: APIM necesita el legajo de quien ejecuta la acción (formato l#######) y sale de su mail; '$LEGAJO' no lo es. Para probar con otro usuario configurá LEGAJO_OVERRIDE en el agente."
  fi
}

require_source_repository() {
  local url="$1" path
  path=$(echo "$url" | sed -E 's#^https?://[^/]+/##; s#\.git$##; s#/+$##')
  if [[ ! "$path" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    fail "publisher: el repository_url de la aplicación ('$url') no es https://<host>/<org>/<repo>."
  fi
  SOURCE_ORGANIZATION="${path%%/*}"
  SOURCE_REPOSITORY="${path##*/}"
}

require_cluster_name() {
  CLUSTER_NAME=$(echo "${CONTEXT-}" | jq -r '.providers["container-orchestration"].cluster.id // empty' 2>/dev/null) || CLUSTER_NAME=""
  if [ -n "${APIM_CLUSTER_NAME-}" ]; then
    CLUSTER_NAME="$APIM_CLUSTER_NAME"
  fi
  if [ -z "$CLUSTER_NAME" ]; then
    fail "publisher: el provider no trae cluster.id; configurá APIM_CLUSTER_NAME en el agente."
  fi
}

require_sigla_and_project() {
  PUBLISH_PROJECT="$1"
  PUBLISH_SIGLA="${1%%-*}"
  if [ -n "${APIM_PROJECT-}" ]; then
    PUBLISH_PROJECT="$APIM_PROJECT"
  fi
  if [ -n "${APIM_SIGLA-}" ]; then
    PUBLISH_SIGLA="$APIM_SIGLA"
  fi
  if [ -z "$PUBLISH_PROJECT" ] || [ -z "$PUBLISH_SIGLA" ]; then
    fail "publisher: la notificación no trae el tag namespace para la sigla y el project; configurá APIM_SIGLA y APIM_PROJECT en el agente."
  fi
}

require_deployed_release() {
  local scope_id="$1" scope_slug="$2" entity deployment_id release_id
  entity=$(np scope read --id "$scope_id" --format json) \
    || fail "publisher: no se pudo leer el scope '$scope_slug' para saber qué versión tiene desplegada."
  deployment_id=$(echo "$entity" | jq -r '.active_deployment // empty')
  if [[ ! "$deployment_id" =~ ^[0-9]+$ ]]; then
    fail "publisher: no se puede publicar una aplicación que no está desplegada: el scope '$scope_slug' no tiene un deployment activo."
  fi
  entity=$(np deployment read --id "$deployment_id" --format json) \
    || fail "publisher: no se pudo leer el deployment activo $deployment_id del scope '$scope_slug'."
  release_id=$(echo "$entity" | jq -r '.release_id // empty')
  if [[ ! "$release_id" =~ ^[0-9]+$ ]]; then
    fail "publisher: el deployment activo $deployment_id del scope '$scope_slug' no tiene release."
  fi
  entity=$(np release read --id "$release_id" --format json) \
    || fail "publisher: no se pudo leer el release $release_id desplegado en el scope '$scope_slug'."
  DEPLOYED_RELEASE=$(echo "$entity" | jq -r '.semver // empty')
  if [[ ! "$DEPLOYED_RELEASE" =~ ^[A-Za-z0-9][A-Za-z0-9._/+-]*$ ]]; then
    fail "publisher: el release $release_id desplegado en el scope '$scope_slug' no tiene un semver que se pueda publicar como tag ('$DEPLOYED_RELEASE')."
  fi
}

require_parent_refs() {
  local gateway="${INGRESS_GATEWAY_NAME:-s2s-ingress}" namespace="${GATEWAY_NAMESPACE:-gateways}"
  local label='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
  if [[ ! "$gateway" =~ $label ]]; then
    fail "publisher: INGRESS_GATEWAY_NAME inválido: '$gateway'."
  fi
  if [[ ! "$namespace" =~ $label ]]; then
    fail "publisher: GATEWAY_NAMESPACE inválido: '$namespace'."
  fi
  PARENT_REFS=$(jq -nc --arg name "$gateway" --arg namespace "$namespace" \
    '[{group: "gateway.networking.k8s.io", kind: "Gateway", name: $name, namespace: $namespace}]')
}

require_scope_destination() {
  local scope="$1" application_id="$2" scopes scope_id
  if [ -z "$scope" ]; then
    fail "publisher: falta el scope que atiende la API."
  fi
  if [ -z "$application_id" ]; then
    fail "publisher: el contexto no trae application.id; no se puede resolver el scope."
  fi
  scopes=$(np scope list --application-id "$application_id" --status active --format json \
    --query '[ (.results? // .) | .[]? | {slug, id, domain, dimensions} ]') \
    || fail "publisher: falló el listado de scopes de la aplicación $application_id."
  scope_id=$(echo "$scopes" | jq -r --arg s "$scope" '[.[] | select(.slug == $s) | .id] | first // empty')
  if [[ ! "$scope_id" =~ ^[0-9]+$ ]]; then
    fail "publisher: el scope '$scope' no está entre los scopes activos de la aplicación."
  fi
  SCOPE_ID="$scope_id"
  SCOPE_SLUG="$scope"
  SCOPE_DOMAIN=$(echo "$scopes" | jq -r --arg s "$scope" '[.[] | select(.slug == $s) | .domain // empty] | first // empty')
  if [ -z "$SCOPE_DOMAIN" ]; then
    fail "publisher: el scope '$scope' no tiene dominio; no hay a dónde mandar el tráfico de la API."
  fi
  if [[ ! "$SCOPE_DOMAIN" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]; then
    fail "publisher: el dominio del scope '$scope' no es un hostname válido: '$SCOPE_DOMAIN'."
  fi
}

require_gateway_backend() {
  local host="${LOCAL_INGRESS_HOST-s2s-ingress-istio.gateways.svc.cluster.local}" port="${APIM_GATEWAY_PORT:-443}" name namespace
  local label='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
  if [[ ! "$host" =~ ^($label)\.($label)(\..*)?$ ]]; then
    fail "publisher: LOCAL_INGRESS_HOST inválido: '$host'. Tiene que ser <service>.<namespace>[.svc.cluster.local] del ingreso del cluster."
  fi
  name="${BASH_REMATCH[1]}"
  namespace="${BASH_REMATCH[3]}"
  if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]]; then
    fail "publisher: APIM_GATEWAY_PORT inválido: '$port'."
  fi
  GATEWAY_BACKEND=$(jq -nc --arg name "$name" --arg namespace "$namespace" --argjson port "$port" \
    '{kind: "Service", name: $name, namespace: $namespace, port: $port}')
}

require_api_id_format() {
  if ! api_id_is_valid "$1"; then
    fail "publisher: APIM devolvió un apiId que no sirve como nombre de Kubernetes: '$1'."
  fi
}

attach_scope_auth_policies() {
  local api_id="$1" namespace="$2" scope_id="$3" scope_slug="$4" routes route
  require_api_id_format "$api_id"
  routes=$(kubectl -n "$namespace" get httproute -l "nullplatform=true,scope_id=$scope_id" -o json) \
    || fail "publisher: no se pudieron leer las routes del scope '$scope_slug' en el namespace $namespace."
  routes=$(echo "$routes" | jq -r '.items[]?.metadata.name')
  if [ -z "$routes" ]; then
    fail "publisher: el scope '$scope_slug' no tiene routes en el cluster; desplegalo y volvé a publicar."
  fi
  while IFS= read -r route; do
    scope_auth_policy "$api_id" "$namespace" "$scope_id" "$route" | kubectl apply -f - >/dev/null \
      || fail "publisher: no se pudo colgar la AuthPolicy de $api_id en la route $route."
    log info "publisher: la route $route acepta las credenciales de $api_id."
  done <<<"$routes"
  delete_scope_auth_policies "$namespace" "scope_id=$scope_id,api-id!=$api_id"
}

reconcile_scope_auth_policies() {
  local api_id="$1" namespace="$2" scope_id="$3" scope_slug="$4" application_type
  application_type=$(resolve_application_type "${CONTEXT-}")
  if application_type_skips_auth_policy "$application_type"; then
    log info "publisher: la aplicación es de tipo $application_type; las routes del scope '$scope_slug' quedan sin AuthPolicy y la autenticación queda en la aplicación."
    delete_scope_auth_policies "$namespace" "scope_id=$scope_id"
    return 0
  fi
  if [ -z "$application_type" ]; then
    log info "publisher: la aplicación no declara application_type en su metadata; las routes del scope '$scope_slug' llevan AuthPolicy."
  else
    log info "publisher: la aplicación es de tipo $application_type; las routes del scope '$scope_slug' llevan AuthPolicy."
  fi
  attach_scope_auth_policies "$api_id" "$namespace" "$scope_id" "$scope_slug"
}

delete_scope_auth_policies() {
  local namespace="$1" selector="$2"
  kubectl -n "$namespace" delete authpolicy -l "$AUTH_POLICY_MANAGED_BY,$selector" --ignore-not-found >/dev/null \
    || fail "publisher: no se pudieron borrar las AuthPolicies ($selector) del namespace $namespace; reintentá la acción."
}
