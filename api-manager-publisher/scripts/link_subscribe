#!/usr/bin/env bash
set -euo pipefail

LINK_SUBSCRIBE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$LINK_SUBSCRIBE_DIR/publisher_lib"

ACTION_ENTITY=link
ACTION_SETTLED=0
trap close_on_unexpected_exit EXIT

link_subscribe() {
  require_agent_config
  load_notification

  local params link_id action_id
  params=$(echo "$NOTIFICATION" | jq -c '(.link.attributes // {}) * (.parameters // {})')
  link_id=$(notification_field '.link.id')
  action_id=$(notification_field '.id')
  require_action_ids "$link_id" "$action_id"
  require_provider_namespace

  local credential_env
  credential_env=$(yq -r '.configuration.APIM_CREDENTIAL_ENV | map(.name) | join(" y ")' "$LINK_SUBSCRIBE_DIR/../override/values.yaml")
  SUBSCRIPTION_CREDENTIAL_HINT="Tus deployments reciben la credencial como $credential_env a partir del próximo deploy: mandalas en los headers app_id y app_key."

  request_subscription \
    "$(echo "$params" | jq -r '.approval_ref // empty')" \
    "$(echo "$params" | jq -r '.plan_id // empty')" \
    "$PROVIDER_NAMESPACE" \
    "$(callback_url "$link_id" "$action_id")" \
    "$action_id"
}

link_subscribe
