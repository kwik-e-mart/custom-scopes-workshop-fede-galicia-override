#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../../../../shared/scripts/mount_files"

has_link_for_scope() {
  local application_nrn scope_nrn dimensions existing_links
  application_nrn=$(echo "$CONTEXT" | jq -r .application.nrn)
  scope_nrn=$(echo "$CONTEXT" | jq -r .scope.nrn)
  dimensions=$(echo "$CONTEXT" | jq -c '.scope.dimensions // {}')

  existing_links=$(np link list --nrn "$application_nrn" --status active --format json --show_descendants | jq -c \
    --arg provider "$POM_SERVICES_PROVIDER" \
    --arg app "$application_nrn" \
    --arg scope "$scope_nrn" \
    --argjson dims "$dimensions" '
    (.results? // .) | map(select(
      .selectors.provider == $provider
      and (
        .entity_nrn == $scope
        or (
          .entity_nrn == $app
          and ([ (.dimensions // {}) | to_entries[] | .value == ($dims[.key]) ] | all)
        )
      )
    ))
  ') || {
    echo "❌ Failed to list links for $application_nrn" >&2
    exit 1
  }

  [[ "$(echo "$existing_links" | jq 'length')" -gt 0 ]]
}

if ! has_link_for_scope; then
  echo "ℹ️ No pom-services link associated to this scope — skipping jwt-secret mount"
  return 0
fi

mount_files "pom-services" "$POM_SERVICES_MOUNTS"
