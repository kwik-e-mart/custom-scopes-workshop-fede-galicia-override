#!/bin/bash
set -euo pipefail

# Certificate volumes shared at the pod level (Deployment or CronJob pod spec).
# Defined as block YAML so env() parses them with plain keys and block style.
export CERT_VOLUMES='
- name: cakeystore
  secret:
    secretName: secret-cabanco-keystore
    defaultMode: 420
- name: caroot
  secret:
    secretName: secret-cabanco-root
    defaultMode: 420
- name: caintermedia
  secret:
    secretName: secret-cabanco-intermedia
    defaultMode: 420
- name: cabanco-chain
  secret:
    secretName: secret-cabanco-chain
    defaultMode: 420
'

# Mounts injected only into the container named "application".
export CERT_VOLUME_MOUNTS='
- name: cakeystore
  readOnly: true
  mountPath: /opt/cabanco/keystore
- name: caroot
  readOnly: true
  mountPath: /opt/cabanco/caroot
- name: caintermedia
  readOnly: true
  mountPath: /opt/cabanco/caintermedia
- name: cabanco-chain
  readOnly: true
  mountPath: /opt/cabanco/cabanco-chain
'

for deployment_file in "$OUTPUT_DIR"/deployment-*.yaml; do
  if [ -f "$deployment_file" ]; then
    kind=$(yq eval '.kind' "$deployment_file")

    echo "📝 Mounting cabanco certificates into $deployment_file (kind: $kind)"

    # A CronJob nests the pod spec one level deeper than a Deployment.
    if [ "$kind" = "CronJob" ]; then
      pod_spec=".spec.jobTemplate.spec.template.spec"
    else
      pod_spec=".spec.template.spec"
    fi

    # Fail loudly if there is no "application" container to mount into.
    app_container=$(yq eval "${pod_spec}.containers[] | select(.name == \"application\") | .name" "$deployment_file")
    if [ -z "$app_container" ]; then
      echo "❌ No container named 'application' found in $deployment_file (kind: $kind)" >&2
      echo "💡 Possible causes:" >&2
      echo "   - The container was renamed or the manifest uses a different pod-spec path" >&2
      echo "🔧 How to fix:" >&2
      echo "   - Inspect containers: yq eval '${pod_spec}.containers[].name' $deployment_file" >&2
      exit 1
    fi

    # Volumes go on the shared pod spec; volumeMounts only on the "application" container.
    yq eval -i "${pod_spec}.volumes += env(CERT_VOLUMES)" "$deployment_file"
    yq eval -i "(${pod_spec}.containers[] | select(.name == \"application\") | .volumeMounts) += env(CERT_VOLUME_MOUNTS)" "$deployment_file"

    echo "✅ Added ${pod_spec}.volumes and mounts on container 'application' in $deployment_file"
  fi
done
