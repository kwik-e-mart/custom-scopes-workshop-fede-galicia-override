# Copiar a terraform.tfvars y completar. Aplicar con `tofu apply`.
# Un apply POR CLUSTER: los prerequisitos son de cluster, no de organización.

kubeconfig_path = "~/.kube/config"
kube_context    = "REEMPLAZAR"

# En EKS normalmente true (no trae los CRDs de Gateway API).
# En OpenShift dejar en false: los trae y los gestiona su propio operator.
manage_gateway_api_crds = false
