#!/usr/bin/env bash
set -euo pipefail

# $CONTEXT lo arma el CLI con --build-context y sólo trae los recursos que fue a buscar
# (account, application, namespace, providers). Los datos de la instancia viven en la
# notificación.
NOTIFICATION=$(printf %s "$NP_ACTION_CONTEXT" | jq -c '.notification')
SERVICE_ATTRS=$(printf %s "$NOTIFICATION" | jq -c '(.service.attributes // {}) * (.parameters // {})')
INTERCEPTIONS_JSON=$(printf %s "$SERVICE_ATTRS" | jq -c '.interceptions // []')
SERVICE_ID=$(printf %s "$NOTIFICATION" | jq -r '.service.id // empty')

# El namespace del servicio DESTINO: la instancia se cuelga de la aplicación dueña del servicio, no
# de la que lo consume. Ahí es donde se intercepta, y por eso una regla alcanza para todos los
# callers.
NAMESPACE="${NAMESPACE_OVERRIDE:-}"
if [ -z "$NAMESPACE" ]; then
  NAMESPACE=$(echo "$CONTEXT" | jq -r '.providers["container-orchestration"].cluster.namespace // empty' 2>/dev/null || true)
fi
NAMESPACE="${NAMESPACE:-nullplatform}"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../../shared/scripts/sigla"
SIGLA=$(resolve_sigla "$CONTEXT")

PEER_CA_SECRET="${PEER_CA_SECRET:-s2s-remote-ca}"
LISTEN_PORT="${LISTEN_PORT:-8080}"
TOKEN_DURATION="${TOKEN_DURATION:-60}"
GATEWAY_CLASS="${GATEWAY_CLASS:-istio}"
OVERRIDES_ACTIVOS=""
# El ingreso del sustrato opuesto. Es configuración del service y NO un campo del form: el dev
# declara identidades de nullplatform, nunca direcciones de transporte.
PEER_GATEWAY_HOST="${PEER_GATEWAY_HOST:-}"
# El ingreso de ESTE cluster. Con origen EKS la rama no migrada también entra por un Gateway.
LOCAL_INGRESS_HOST="${LOCAL_INGRESS_HOST:-s2s-ingress-istio.gateways.svc.cluster.local}"
if [ -n "${LOCAL_INGRESS_HOST_OVERRIDE:-}" ]; then
  LOCAL_INGRESS_HOST="$LOCAL_INGRESS_HOST_OVERRIDE"
  OVERRIDES_ACTIVOS="${OVERRIDES_ACTIVOS} LOCAL_INGRESS_HOST=${LOCAL_INGRESS_HOST}"
fi
LOCAL_INGRESS_TLS_MODE="${LOCAL_INGRESS_TLS_MODE-skip-verify}"
LOCAL_INGRESS_SERVICE="${LOCAL_INGRESS_HOST%%.*}"
LOCAL_INGRESS_SERVICE_NAMESPACE="${LOCAL_INGRESS_HOST#*.}"
LOCAL_INGRESS_SERVICE_NAMESPACE="${LOCAL_INGRESS_SERVICE_NAMESPACE%%.*}"
# Namespace del Gateway de ingreso. Es `gateways` y no `istio-system` porque el template de
# HTTPRoute de los scopes de nullplatform hardcodea ese namespace en su parentRef.
GATEWAY_NAMESPACE="${GATEWAY_NAMESPACE:-gateways}"
if [ -n "${GATEWAY_NAMESPACE_OVERRIDE:-}" ]; then
  GATEWAY_NAMESPACE="$GATEWAY_NAMESPACE_OVERRIDE"
  OVERRIDES_ACTIVOS="${OVERRIDES_ACTIVOS} GATEWAY_NAMESPACE=${GATEWAY_NAMESPACE}"
fi
# La AuthPolicy que valida el wristband en el ingreso de ESTE cluster. La emite este service y
# espera a que quede Enforced después de colgarle su route de ingreso: Kuadrant no aplica una
# policy que no esté en el camino de ninguna route, y sin ese wait el destino aceptaría tráfico
# del otro sustrato sin validar el token.
INGRESS_AUTHPOLICY="${INGRESS_AUTHPOLICY:-s2s-validator}"

SIGNING_STRATEGY="${S2S_TRAFFIC_MIGRATOR_SIGNING_STRATEGY-cluster-keys}"
case "$SIGNING_STRATEGY" in
  cluster-keys|spiffe) ;;
  *)
    log error "egress-interceptor: S2S_TRAFFIC_MIGRATOR_SIGNING_STRATEGY='${SIGNING_STRATEGY}' no es una estrategia de firma válida."
    log error "  Valores: cluster-keys (default, wristband firmado con una clave del cluster) | spiffe (JWT-SVID minteado por Vault)"
    exit 1 ;;
esac

NETWORKING_VAULT_ADDR="${NETWORKING_VAULT_ADDR:-}"
NETWORKING_VAULT_NAMESPACE="${NETWORKING_VAULT_NAMESPACE:-}"
NETWORKING_VAULT_SPIFFE_MOUNT="${NETWORKING_VAULT_SPIFFE_MOUNT:-}"
NETWORKING_VAULT_SPIFFE_ROLE="${NETWORKING_VAULT_SPIFFE_ROLE:-s2s-egress}"
NETWORKING_VAULT_TOKEN_SECRET="${NETWORKING_VAULT_TOKEN_SECRET:-s2s-vault-token}"
KEYGEN_IMAGE="${KEYGEN_IMAGE:-alpine/k8s:1.30.3}"
VAULT_APPROLE_ROLE_ID="${VAULT_APPROLE_ROLE_ID:-}"
VAULT_APPROLE_SECRET="${VAULT_APPROLE_SECRET:-vault-approle-creds}"
VAULT_SECRET_STORE="${VAULT_SECRET_STORE:-vault-eks-plataforma}"
LOCAL_JWKS_URL="${LOCAL_JWKS_URL:-}"
PEER_JWKS_URL="${PEER_JWKS_URL:-}"
JWKS_SERVICE_NAME="${JWKS_SERVICE_NAME:-jwks-egress}"
JWKS_IMAGE="${JWKS_IMAGE:-registry.access.redhat.com/ubi9/httpd-24:latest}"
INGRESS_GATEWAY_NAME="${INGRESS_GATEWAY_NAME:-s2s-ingress}"
if [ -n "${INGRESS_GATEWAY_NAME_OVERRIDE:-}" ]; then
  INGRESS_GATEWAY_NAME="$INGRESS_GATEWAY_NAME_OVERRIDE"
  OVERRIDES_ACTIVOS="${OVERRIDES_ACTIVOS} INGRESS_GATEWAY_NAME=${INGRESS_GATEWAY_NAME}"
fi
# La AuthPolicy que firma el wristband a la salida. La crea el chart del namespace y su
# `signingKeyRefs` es la fuente de verdad de cuál es la clave vigente.
EGRESS_AUTHPOLICY="${EGRESS_AUTHPOLICY:-sign}"
# Authorino lee el Secret de firma SOLO de su propio namespace, no del de la app: es donde el
# chart la deja y no es configurable del otro lado.
KEYS_NAMESPACE="kuadrant-system"
# Dominio del `iss` del wristband. El chart arma `https://egress.<cluster>.<issuerDomain>` y el
# validador compara el claim contra ese valor exacto, así que los dos lados tienen que coincidir.
ISSUER_DOMAIN="${ISSUER_DOMAIN:-bancogalicia.com.ar}"
# Los objetos del alta de namespace los crea el chart del cliente. En true los emitimos nosotros,
# con los mismos nombres, para el namespace donde el chart no corrió o quedó a medias.
INGRESS_VALIDATOR_WAIT_ENFORCED="${INGRESS_VALIDATOR_WAIT_ENFORCED-true}"
case "$INGRESS_VALIDATOR_WAIT_ENFORCED" in
  true|false) ;;
  *)
    log error "egress-interceptor: INGRESS_VALIDATOR_WAIT_ENFORCED='${INGRESS_VALIDATOR_WAIT_ENFORCED}' no es válido. Valores: true | false"
    exit 1 ;;
esac
NAMESPACE_SETUP_ENABLED="${NAMESPACE_SETUP_ENABLED:-false}"
case "$NAMESPACE_SETUP_ENABLED" in
  true|false) ;;
  *)
    log error "egress-interceptor: NAMESPACE_SETUP_ENABLED='${NAMESPACE_SETUP_ENABLED}' no es válido. Valores: true | false"
    exit 1 ;;
esac

warn_inert() {
  local name="$1" value="$2" default="$3"
  [ -n "$value" ] || return 0
  [ "$value" != "$default" ] || return 0
  log warn "egress-interceptor: ${name} está declarada pero la estrategia de firma es '${SIGNING_STRATEGY}': ese valor NO tiene efecto."
}

if [ "$SIGNING_STRATEGY" = "spiffe" ]; then
  warn_inert TOKEN_DURATION "${TOKEN_DURATION:-}" 60
  warn_inert WRISTBAND_SECRET_NAME "${WRISTBAND_SECRET_NAME:-}" 'wristband-key-{namespace}-g0'
  warn_inert EGRESS_ISSUER_URL "${EGRESS_ISSUER_URL:-}" "https://egress.{cluster}.${ISSUER_DOMAIN}"
else
  warn_inert NETWORKING_VAULT_SPIFFE_MOUNT "$NETWORKING_VAULT_SPIFFE_MOUNT" ""
  warn_inert NETWORKING_VAULT_SPIFFE_ROLE "$NETWORKING_VAULT_SPIFFE_ROLE" s2s-egress
fi

# La plataforma sale de la dimension 'site' de la instancia, no del entorno del agente: un agente
# puede atender instancias de sustratos distintos.
SITE=$(printf %s "$NP_ACTION_CONTEXT" | jq -r '.notification.service.dimensions.site // empty') \
  || { log error "egress-interceptor: no se pudo leer la dimension site de la notificacion."; exit 1; }
if [ -z "$SITE" ]; then
  log error "egress-interceptor: la instancia no declara la dimension 'site'. Es obligatoria: de ahi sale en que plataforma corre y en que carpeta del repo gitops se publica."
  exit 1
fi
case "$SITE" in
  aws*) PLATFORM=eks ;;
  openshift*) PLATFORM=openshift ;;
  *)
    log error "egress-interceptor: site '$SITE' no reconocido. Se esperan los prefijos 'aws' (EKS) u 'openshift'."
    exit 1 ;;
esac
export SITE PLATFORM
# Cómo se identifica ESTE cluster en el header x-s2s-cluster. Se calcula DESPUÉS de SITE: con
# `set -u`, leerlo antes aborta el script con "unbound variable".
CLUSTER_LABEL="${CLUSTER_LABEL:-$SITE}"

VAULT_KV_CLUSTER="${VAULT_KV_CLUSTER:-}"
if [ -z "$VAULT_KV_CLUSTER" ]; then
  VAULT_KV_CLUSTER=$(echo "$CONTEXT" | jq -r '.providers["container-orchestration"].cluster.id // empty' 2>/dev/null || true)
fi
VAULT_KV_CLUSTER="${VAULT_KV_CLUSTER:-$CLUSTER_LABEL}"

case "$PLATFORM" in
  eks) VAULT_KV_SUBSTRATE=eks ;;
  *)   VAULT_KV_SUBSTRATE=ocp ;;
esac
VAULT_KV_MOUNT="${VAULT_KV_MOUNT:-kv/$VAULT_KV_SUBSTRATE}"

# Estos valores se interpolan en YAML que el cluster aplica y en comandos del reconcile.
require_match() {  # <value> <regex> <field>
  local val="$1" re="$2" name="$3"
  if [[ ! "$val" =~ $re ]]; then
    log error "egress-interceptor build_context: valor inválido para ${name}: '${val}'"
    exit 1
  fi
}
require_match "$NAMESPACE" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "namespace"
[ -n "$SERVICE_ID" ] && require_match "$SERVICE_ID" '^[a-zA-Z0-9_-]{1,64}$' "service.id"

# Cuál es la clave vigente lo dice la AuthPolicy de firma, no el nombre del Secret: el rotador
# parchea ahí `signingKeyRefs` en cada rotación y el nombre que pone lleva un timestamp, que no se
# puede derivar. Buscar el Secret por label tampoco sirve, porque los que crea el chart del
# namespace no llevan ninguna.
# Devuelve 0 con el nombre, 2 si todavía no hay AuthPolicy o no tiene clave, 1 si la API falló.
# Lo mismo vale para el `iss` y para el cluster que nombran los claims: los arma el chart desde su
# propio values, y el validador los compara carácter por carácter. Derivarlos de nuestras variables
# es pedir que cuatro valores coincidan en dos lugares distintos; cuando no coinciden el único
# síntoma es un 401 sin pista. Se leen del mismo objeto que firma.
if ! type -t signing_policy_field >/dev/null 2>&1; then
signing_policy_field() {  # <jsonpath relativo al wristband>
  local out
  if ! out=$(kubectl -n "$NAMESPACE" get authpolicy "$EGRESS_AUTHPOLICY" \
      -o jsonpath="{.spec.rules.response.success.headers.x-egress-token.wristband.$1}" 2>&1); then
    case "$out" in
      *NotFound*|*not\ found*) return 2 ;;
      *)
        log error "egress-interceptor: no se pudo leer la AuthPolicy '$EGRESS_AUTHPOLICY' de '$NAMESPACE'." >&2
        log error "  $out" >&2
        return 1 ;;
    esac
  fi
  [ -n "$out" ] || return 2
  printf '%s' "$out"
}
fi

if ! type -t current_wristband_secret >/dev/null 2>&1; then
current_wristband_secret() {
  local out
  if ! out=$(kubectl -n "$NAMESPACE" get authpolicy "$EGRESS_AUTHPOLICY" \
      -o jsonpath='{.spec.rules.response.success.headers.x-egress-token.wristband.signingKeyRefs[0].name}' 2>&1); then
    case "$out" in
      *NotFound*|*not\ found*) return 2 ;;
      *)
        log error "egress-interceptor: no se pudo leer la AuthPolicy '$EGRESS_AUTHPOLICY' de '$NAMESPACE'." >&2
        log error "  $out" >&2
        return 1 ;;
    esac
  fi
  [ -n "$out" ] || return 2
  printf '%s' "$out"
}
fi

resolve_wristband_secret() {
  if [ -n "${WRISTBAND_SECRET_NAME:-}" ]; then
    printf '%s' "${WRISTBAND_SECRET_NAME//\{namespace\}/$NAMESPACE}"
    return 0
  fi
  if [ "$SIGNING_STRATEGY" != "cluster-keys" ]; then
    printf '%s-wristband-key' "$NAMESPACE"
    return 0
  fi
  local found rc=0
  found=$(current_wristband_secret) || rc=$?
  case "$rc" in
    0) printf '%s' "$found" ;;
    2) printf 'wristband-key-%s-g0' "$NAMESPACE" ;;
    *) return 1 ;;
  esac
}

WRISTBAND_SECRET=$(resolve_wristband_secret) || {
  log error "egress-interceptor: no se pudo resolver la clave de firma de '$NAMESPACE'. No se aplicó nada."
  log error "  El agente necesita 'list' sobre secrets en '$KEYS_NAMESPACE' (Role np-agent-keys)."
  exit 1
}
require_match "$WRISTBAND_SECRET" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "wristband_secret_name"

require_match "$VAULT_KV_CLUSTER" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "vault_kv_cluster"

# El cluster que nombran los claims y el path del JWKS: el del chart, no el nuestro. Sólo se cae al
# VAULT_KV_CLUSTER cuando todavía no hay AuthPolicy que leer.
if [ "$SIGNING_STRATEGY" = "cluster-keys" ]; then
  CLAIM_CLUSTER=$(signing_policy_field 'customClaims.src_cluster.value') || CLAIM_CLUSTER=""
else
  CLAIM_CLUSTER=""
fi
[ -n "$CLAIM_CLUSTER" ] || CLAIM_CLUSTER="$VAULT_KV_CLUSTER"
require_match "$CLAIM_CLUSTER" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "claim_cluster"

EGRESS_ISSUER="${EGRESS_ISSUER_URL:-}"
if [ -z "$EGRESS_ISSUER" ] && [ "$SIGNING_STRATEGY" = "cluster-keys" ]; then
  EGRESS_ISSUER=$(signing_policy_field 'issuer') || EGRESS_ISSUER=""
fi
[ -n "$EGRESS_ISSUER" ] || EGRESS_ISSUER="https://egress.{cluster}.${ISSUER_DOMAIN}"
EGRESS_ISSUER=${EGRESS_ISSUER//\{namespace\}/$NAMESPACE}
EGRESS_ISSUER=${EGRESS_ISSUER//\{cluster\}/$CLAIM_CLUSTER}
LOCAL_JWKS_URL=${LOCAL_JWKS_URL//\{namespace\}/$NAMESPACE}
LOCAL_JWKS_URL=${LOCAL_JWKS_URL//\{cluster\}/$CLAIM_CLUSTER}
PEER_JWKS_URL=${PEER_JWKS_URL//\{namespace\}/$NAMESPACE}
PEER_JWKS_URL=${PEER_JWKS_URL//\{cluster\}/$CLAIM_CLUSTER}
[ -n "$LOCAL_JWKS_URL" ] || LOCAL_JWKS_URL="http://${JWKS_SERVICE_NAME}.${NAMESPACE}.svc.cluster.local:8080/${CLAIM_CLUSTER}/${NAMESPACE}/jwks.json"
require_match "$EGRESS_ISSUER" '^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$' "egress_issuer_url"

gitops_substrate_hint() {
  printf %s "$SITE"
}

GITOPS_BRANCH="${GITOPS_BRANCH:-main}"
GITOPS_PATH_PREFIX="${GITOPS_PATH_PREFIX:-}"
GITOPS_PUSH_RETRIES="${GITOPS_PUSH_RETRIES:-5}"

if [ -n "${GITOPS_REPO_URL:-}" ]; then
  require_match "$GITOPS_BRANCH" '^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$' "gitops_branch"
  require_match "$GITOPS_PUSH_RETRIES" '^[1-9][0-9]?$' "gitops_push_retries"
  if [ -n "$GITOPS_PATH_PREFIX" ]; then
    require_match "$GITOPS_PATH_PREFIX" '^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$' "gitops_path_prefix"
    case "$GITOPS_PATH_PREFIX" in
      *..*)
        log error "egress-interceptor: GITOPS_PATH_PREFIX no puede contener '..'."
        exit 1 ;;
    esac
  fi
  log info "gitops: se publica en ${GITOPS_PATH_PREFIX:+${GITOPS_PATH_PREFIX%/}/}$(gitops_substrate_hint)/${NAMESPACE} (branch ${GITOPS_BRANCH})"
fi

export GITOPS_BRANCH GITOPS_PATH_PREFIX GITOPS_PUSH_RETRIES

INTERCEPTIONS_JSON=$(printf %s "$INTERCEPTIONS_JSON" | jq -c '
  map(((.service_name // "") | tostring | ascii_downcase | sub("\\.+$"; "")) as $raw
      | ($raw | split(".")) as $labels
      | . + { service_input: $raw,
              service_name: ($labels[0] // ""),
              service_suffix: ($labels[1:] | join(".")) })') \
  || { log error "egress-interceptor: no se pudieron normalizar los nombres de las reglas."; exit 1; }

NAME_ERRORS=$(printf %s "$INTERCEPTIONS_JSON" | jq -r --arg ns "$NAMESPACE" '
  def formas($s): "\($s) | \($s).\($ns) | \($s).\($ns).svc | \($s).\($ns).svc.cluster.local";
  .[]
  | .service_input as $in | .service_name as $svc | .service_suffix as $suf
  | if ($svc | length) == 0 then
      if ($in | length) == 0
      then "nombre hay una regla sin nombre de servicio. Cada regla declara el Service del namespace '\''\($ns)'\'' cuyo tráfico se migra."
      else "nombre '\''\($in)'\'' no empieza con un nombre de servicio."
      end
    elif ($svc | test("\\A[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\z") | not) then
      "nombre '\''\($in)'\'': '\''\($svc)'\'' no es un nombre de Service válido."
    elif (["", $ns, "\($ns).svc", "\($ns).svc.cluster.local"] | index($suf)) == null then
      "namespace no se entiende '\''\($in)'\'' como un servicio del namespace '\''\($ns)'\''. Formas válidas: \(formas($svc))"
    else empty
    end') \
  || { log error "egress-interceptor: no se pudieron validar los nombres de las reglas."; exit 1; }

if [ -n "$NAME_ERRORS" ]; then
  NS_ERROR=""
  while IFS= read -r NAME_ERROR; do
    [ "${NAME_ERROR%% *}" = "namespace" ] && NS_ERROR=1
    log error "egress-interceptor: ${NAME_ERROR#* }"
  done <<<"$NAME_ERRORS"
  if [ -n "$NS_ERROR" ]; then
    log error "  El interceptor sólo migra tráfico INTRA-NAMESPACE: actúa sobre el Service del namespace"
    log error "  del destino, que es el de la aplicación dueña de esta instancia."
    log error "  Para exponer un servicio a consumidores de OTROS namespaces, el service es Endpoint Exposer."
  fi
  exit 1
fi

printf %s "$INTERCEPTIONS_JSON" \
  | jq -r '.[] | select(.service_input != .service_name) | "  regla: \(.service_input) → service \(.service_name)"' \
  | while IFS= read -r MAP_LINE; do log info "$MAP_LINE"; done

DUP_SERVICES=$(printf %s "$INTERCEPTIONS_JSON" | jq -r '
  group_by(.service_name) | map(select(length > 1))
  | .[] | "  \(.[0].service_name) ← \([.[].service_input] | join(" + "))"') \
  || { log error "egress-interceptor: no se pudo chequear reglas duplicadas."; exit 1; }
if [ -n "$DUP_SERVICES" ]; then
  log error "egress-interceptor: hay más de una regla para el mismo servicio."
  log error "$DUP_SERVICES"
  log error "  Cada servicio se declara UNA sola vez: el percent es un único dial por destino."
  exit 1
fi

INTERCEPTIONS_JSON=$(printf %s "$INTERCEPTIONS_JSON" | jq -c 'map(del(.service_input, .service_suffix))') \
  || { log error "egress-interceptor: no se pudieron limpiar los auxiliares de normalización."; exit 1; }

if [ "$(printf %s "$INTERCEPTIONS_JSON" | jq '[.[] | select((.scope // "") == "")] | length')" -gt 0 ]; then
  log error "egress-interceptor: hay reglas sin scope. Cada regla declara dónde corre el servicio del lado EKS."
  exit 1
fi

if [ "$(printf %s "$INTERCEPTIONS_JSON" | jq 'length')" -gt 0 ]; then
  if [ -z "$PEER_GATEWAY_HOST" ]; then
    log error "egress-interceptor: falta PEER_GATEWAY_HOST en la configuración del workflow."
    log error "  Es la dirección del ingreso del sustrato opuesto, por donde sale todo lo migrado."
    exit 1
  fi
  if [ "$SIGNING_STRATEGY" = "spiffe" ]; then
    if [ -z "$NETWORKING_VAULT_ADDR" ]; then
      log error "egress-interceptor: falta NETWORKING_VAULT_ADDR en la configuración del workflow."
      log error "  Con la estrategia 'spiffe' el token lo mintea Vault: sin su dirección no hay quién firme."
      exit 1
    fi
    if [ -z "$NETWORKING_VAULT_SPIFFE_MOUNT" ]; then
      log error "egress-interceptor: falta NETWORKING_VAULT_SPIFFE_MOUNT en la configuración del workflow."
      log error "  Es el path donde está montado el secrets engine 'spiffe' que emite los JWT-SVID."
      exit 1
    fi
    require_match "$NETWORKING_VAULT_ADDR" '^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$' "NETWORKING_VAULT_ADDR"
    require_match "$NETWORKING_VAULT_SPIFFE_MOUNT" '^[a-zA-Z0-9]([a-zA-Z0-9._/-]{0,62})?$' "NETWORKING_VAULT_SPIFFE_MOUNT"
    require_match "$NETWORKING_VAULT_TOKEN_SECRET" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "NETWORKING_VAULT_TOKEN_SECRET"
    require_match "$NETWORKING_VAULT_SPIFFE_ROLE" '^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,62})?$' "NETWORKING_VAULT_SPIFFE_ROLE"
    if [ -n "$NETWORKING_VAULT_NAMESPACE" ]; then
      require_match "$NETWORKING_VAULT_NAMESPACE" '^[a-zA-Z0-9]([a-zA-Z0-9._/-]{0,62})?$' "NETWORKING_VAULT_NAMESPACE"
    fi
  fi
  require_match "$GATEWAY_NAMESPACE" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "gateway_namespace"
  require_match "$INGRESS_AUTHPOLICY" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "ingress_authpolicy"
  require_match "$CLUSTER_LABEL" '^[a-zA-Z0-9_.-]{1,63}$' "cluster_label"
  require_match "$VAULT_KV_CLUSTER" '^[a-zA-Z0-9_.-]{1,63}$' "vault_kv_cluster"
  require_match "$JWKS_SERVICE_NAME" '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' "jwks_service_name"
  require_match "$LOCAL_INGRESS_HOST" '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$' "local_ingress_host"
  case "$LOCAL_INGRESS_TLS_MODE" in
    skip-verify|certificate) ;;
    *)
      log error "egress-interceptor: LOCAL_INGRESS_TLS_MODE tiene que ser 'skip-verify' o 'certificate', llegó '$LOCAL_INGRESS_TLS_MODE'."
      log error "  'certificate' valida el cert del ingreso contra PEER_CA_SECRET; 'skip-verify' cifra sin autenticarlo."
      exit 1 ;;
  esac
  if [ "$LOCAL_INGRESS_SERVICE" = "$LOCAL_INGRESS_HOST" ] || [ -z "$LOCAL_INGRESS_SERVICE_NAMESPACE" ]; then
    log error "egress-interceptor: LOCAL_INGRESS_HOST tiene que ser el FQDN de un Service ('<service>.<namespace>.svc.cluster.local'), llegó '$LOCAL_INGRESS_HOST'."
    log error "  De ahí salen el nombre y el namespace del backendRef y del ReferenceGrant."
    exit 1
  fi
  require_match "$PEER_GATEWAY_HOST" '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$' "peer_gateway_host"

  APPLICATION_ID=$(printf %s "$CONTEXT" | jq -r '.application.id // empty')
  if [ -z "$APPLICATION_ID" ]; then
    log error "egress-interceptor: el CONTEXT no trae application.id y hay reglas con scope por resolver."
    log error "  El workflow tiene que correr con --build-context."
    exit 1
  fi

# La HTTPRoute que atiende el FQDN de un scope. El validador se adjunta a ELLA y no al Gateway:
# una AuthPolicy de Gateway la heredan todas las routes colgadas de ahí —incluidas las de negocio
# de otros namespaces— y el síntoma es un 401 en tráfico que nada tiene que ver con S2S.
# Devuelve vacío si todavía no existe: el scope puede no estar desplegado.
if ! type -t route_del_scope >/dev/null 2>&1; then
route_del_scope() {  # <fqdn>
  # El hostname no alcanza para elegir: un mismo FQDN puede estar servido por varias routes, y en
  # la práctica sobreviven las que cuelgan de un Gateway que ya no existe. La que vale es la que
  # cuelga del Gateway de ingreso configurado, que es por donde entra el tráfico que validamos.
  local rutas
  if ! rutas=$(kubectl -n "$NAMESPACE" get httproute -o json 2>&1); then
    log error "egress-interceptor: no se pudieron listar las HTTPRoute de '$NAMESPACE'." >&2
    log error "  $rutas" >&2
    log error "  Sin ese listado no se sabe a qué route colgar el validador, y el tráfico se desviaría sin que nadie valide el token." >&2
    exit 1
  fi
  printf '%s' "$rutas" \
    | jq -r --arg f "$1" --arg gw "$INGRESS_GATEWAY_NAME" --arg gwns "$GATEWAY_NAMESPACE" '
        [ .items[]
          | select((.spec.hostnames // []) | index($f))
          | select([ .spec.parentRefs[]?
                     | select(.name == $gw and ((.namespace // $gwns) == $gwns)) ] | length > 0)
          | .metadata.name ] | first // empty'
}
fi

  # np sale con exit 1 ante un 403 pero escribe el error en STDOUT, así que sin propagar el status
  # esto seguiría con un objeto {error} que jq parsea contento y ningún scope resolvería.
  ACTIVE_SCOPES=$(np scope list --application-id "$APPLICATION_ID" --status active --format json \
    --query '[ (.results? // .) | .[]? | {slug, domain} ]')

  INTERCEPTIONS_JSON=$(printf %s "$INTERCEPTIONS_JSON" | jq -c --argjson scopes "$ACTIVE_SCOPES" '
    map(. as $rule | $rule + {
      scope_fqdn: ([$scopes[] | select(.slug == $rule.scope) | .domain] | first // "")
    })')

  while IFS=$'\t' read -r RULE_SCOPE RULE_FQDN; do
    if [ -z "$RULE_FQDN" ]; then
      log error "egress-interceptor: el scope '$RULE_SCOPE' no está entre los scopes activos de la aplicación $APPLICATION_ID."
      log error "  activos: $(printf %s "$ACTIVE_SCOPES" | jq -r 'if length == 0 then "(ninguno)" else [.[].slug] | join(", ") end')"
      exit 1
    fi
    # Un scope creado pero sin desplegar trae este literal, no null ni vacío. Dejarlo pasar rinde un
    # HTTPRoute que apunta a un hostname inválido y no se queja nadie.
    if [ "$RULE_FQDN" = "To be defined" ]; then
      log error "egress-interceptor: el scope '$RULE_SCOPE' existe pero todavía no está desplegado (domain: 'To be defined')."
      exit 1
    fi
    require_match "$RULE_FQDN" '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$' "el FQDN del scope '$RULE_SCOPE'"
  done < <(printf %s "$INTERCEPTIONS_JSON" | jq -r '.[] | [.scope, .scope_fqdn] | @tsv')

  # El nombre de la route del scope no se puede derivar: lo genera nullplatform con el id del scope.
  # Se descubre por el FQDN, que es el dato que sí tenemos.
  if [ "$PLATFORM" = "eks" ]; then
    RUTAS="{}"
    while IFS= read -r RULE_FQDN; do
      [ -n "$RULE_FQDN" ] || continue
      RUTA=$(route_del_scope "$RULE_FQDN")
      RUTAS=$(printf %s "$RUTAS" | jq -c --arg f "$RULE_FQDN" --arg r "$RUTA" '. + {($f): $r}')
    done < <(printf %s "$INTERCEPTIONS_JSON" | jq -r '.[].scope_fqdn')
    INTERCEPTIONS_JSON=$(printf %s "$INTERCEPTIONS_JSON" | jq -c --argjson rutas "$RUTAS" \
      'map(. + {ingress_route: ($rutas[.scope_fqdn] // "")})')
  else
    INTERCEPTIONS_JSON=$(printf %s "$INTERCEPTIONS_JSON" | jq -c \
      'map(. + {ingress_route: ("s2s-ingress-" + .service_name)})')
  fi
fi

if [ "$PLATFORM" = "eks" ]; then
  SCOPE_DOMAINS=$(printf %s "$INTERCEPTIONS_JSON" \
    | jq -r '[.[] | .scope_fqdn | sub("^[^.]+\\."; "")] | unique | .[]')
  if [ "$(printf '%s\n' "$SCOPE_DOMAINS" | grep -c .)" -gt 1 ]; then
    log error "egress-interceptor: las intercepciones apuntan a scopes de dominios base distintos:"
    log error "  $(printf '%s' "$SCOPE_DOMAINS" | tr '\n' ' ')"
    log error "  El SNI hacia el ingreso local es uno solo por namespace y elige el listener del Gateway."
    log error "  Con dominios mezclados elegiría el equivocado para alguna, y esa falla en silencio."
    exit 1
  fi
fi

export NAMESPACE INTERCEPTIONS_JSON SERVICE_ID WRISTBAND_SECRET EGRESS_ISSUER PEER_CA_SECRET LISTEN_PORT
export TOKEN_DURATION GATEWAY_CLASS PEER_GATEWAY_HOST LOCAL_INGRESS_HOST
export LOCAL_INGRESS_SERVICE LOCAL_INGRESS_SERVICE_NAMESPACE LOCAL_INGRESS_TLS_MODE
export GATEWAY_NAMESPACE CLUSTER_LABEL INGRESS_AUTHPOLICY VAULT_KV_MOUNT VAULT_KV_CLUSTER
export SIGNING_STRATEGY NETWORKING_VAULT_ADDR NETWORKING_VAULT_NAMESPACE
export KEYGEN_IMAGE VAULT_APPROLE_ROLE_ID VAULT_APPROLE_SECRET VAULT_SECRET_STORE LOCAL_JWKS_URL KEYS_NAMESPACE PEER_JWKS_URL INGRESS_GATEWAY_NAME JWKS_SERVICE_NAME JWKS_IMAGE
export EGRESS_AUTHPOLICY ISSUER_DOMAIN NAMESPACE_SETUP_ENABLED INGRESS_VALIDATOR_WAIT_ENFORCED SIGLA
export NETWORKING_VAULT_SPIFFE_MOUNT NETWORKING_VAULT_SPIFFE_ROLE NETWORKING_VAULT_TOKEN_SECRET
if [ -n "$OVERRIDES_ACTIVOS" ]; then
  log info "egress-interceptor: el entorno del agente pisa la configuración del workflow en:$OVERRIDES_ACTIVOS"
fi
log info "build_context OK: ns=$NAMESPACE interceptions=$(echo "$INTERCEPTIONS_JSON" | jq 'length') site=$SITE platform=$PLATFORM strategy=$SIGNING_STRATEGY key=$WRISTBAND_SECRET"
printf %s "$INTERCEPTIONS_JSON" | jq -r '.[] | "  regla: \(.service_name) → scope \(.scope) = \(.scope_fqdn) · \(.percent)% al otro sustrato"' \
  | while IFS= read -r RULE_LINE; do log info "$RULE_LINE"; done
# Dato de salida que parsean los tests, no una traza: va con echo para que no lo filtre LOG_LEVEL.
echo "INTERCEPTIONS_JSON=$INTERCEPTIONS_JSON"
