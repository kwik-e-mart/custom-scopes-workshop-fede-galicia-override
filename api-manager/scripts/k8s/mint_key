#!/usr/bin/env bash
set -euo pipefail

MINT_KEY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$MINT_KEY_DIR/labels_lib"

NOTIFICATION=$(printf %s "$NP_ACTION_CONTEXT" | jq -c '.notification') \
  || { log error "api-manager: NP_ACTION_CONTEXT no es JSON válido o no trae .notification."; exit 1; }
if [ -z "$NOTIFICATION" ] || [ "$NOTIFICATION" = "null" ]; then
  log error "api-manager: NP_ACTION_CONTEXT no es JSON válido o no trae .notification."
  exit 1
fi

LINK_ID=$(printf %s "$NOTIFICATION" | jq -r '.link.id // empty') \
  || { log error "api-manager: no se pudo leer link.id de la notificación."; exit 1; }
if [ -z "$LINK_ID" ]; then
  log error "api-manager: la notificación no trae link.id."
  log error "  Claves disponibles en \$NOTIFICATION: $(printf %s "$NOTIFICATION" | jq -r 'keys | join(", ")')"
  exit 1
fi

if [[ ! "$LINK_ID" =~ ^[a-zA-Z0-9-]{1,48}$ ]]; then
  log error "api-manager: link.id inválido: '$LINK_ID'"
  exit 1
fi

SECRET_NAME="api-manager-${LINK_ID}"
API_KEY=$(openssl rand -hex 32) || { log error "api-manager: no se pudo generar la api key."; exit 1; }

SECRET_MANIFEST=$(jq -nc \
  --arg name "$SECRET_NAME" \
  --arg namespace "$KEYS_NAMESPACE" \
  --arg managed_label "$MANAGED_LABEL" \
  --arg target_label "$TARGET_LABEL" \
  --arg target "$APP_TARGET" \
  --arg key "$API_KEY" \
  '{
    apiVersion: "v1",
    kind: "Secret",
    metadata: {
      name: $name,
      namespace: $namespace,
      labels: ({
        "authorino.kuadrant.io/managed-by": "authorino"
      } + { ($managed_label): "true" } + { ($target_label): $target })
    },
    stringData: { api_key: $key }
  }') || { log error "api-manager: no se pudo armar el manifiesto del Secret '$SECRET_NAME'."; exit 1; }

printf %s "$SECRET_MANIFEST" | kubectl create -f - \
  || { log error "api-manager: falló la creación del Secret '$SECRET_NAME' en '$KEYS_NAMESPACE'. Si ya existía (AlreadyExists), hay dos links pisando el mismo id."; exit 1; }

RESULTS=$(jq -nc --arg k "$API_KEY" '{api_key: $k}') \
  || { log error "api-manager: no se pudieron armar los resultados del link."; exit 1; }

np service action update --results "$RESULTS" \
  || { log error "api-manager: falló la escritura de los resultados del link."; exit 1; }

log info "api-manager: credencial emitida para consumir $APP_TARGET."
