#!/usr/bin/env bash

if ! type -t read_notification >/dev/null 2>&1; then
read_notification() {
  local notification
  notification=$(printf %s "$NP_ACTION_CONTEXT" | jq -c '.notification') \
    || { log error "api-manager: NP_ACTION_CONTEXT no es JSON válido o no trae .notification."; return 1; }
  if [ -z "$notification" ] || [ "$notification" = "null" ]; then
    log error "api-manager: NP_ACTION_CONTEXT no es JSON válido o no trae .notification."
    return 1
  fi
  printf '%s' "$notification"
}
fi

if ! type -t require_link_id >/dev/null 2>&1; then
require_link_id() {
  local notification="$1"
  local link_id
  link_id=$(printf %s "$notification" | jq -r '.link.id // empty') \
    || { log error "api-manager: no se pudo leer link.id de la notificación."; return 1; }
  if [ -z "$link_id" ]; then
    log error "api-manager: la notificación no trae link.id."
    log error "  Claves disponibles en \$NOTIFICATION: $(printf %s "$notification" | jq -r 'keys | join(", ")')"
    return 1
  fi
  if [[ ! "$link_id" =~ ^[a-z0-9]([a-z0-9-]{0,46}[a-z0-9])?$ ]]; then
    log error "api-manager: link.id inválido: '$link_id'. Tiene que ser un nombre DNS-1123: minúsculas, dígitos y guiones, sin empezar ni terminar con guión, de 1 a 48 caracteres."
    return 1
  fi
  printf '%s' "$link_id"
}
fi

if ! type -t require_link_action_id >/dev/null 2>&1; then
require_link_action_id() {
  local notification="$1"
  local action_id
  action_id=$(printf %s "$notification" | jq -r '.id // empty') \
    || { log error "api-manager: no se pudo leer el id de la acción de la notificación."; return 1; }
  if [ -z "$action_id" ]; then
    log error "api-manager: la notificación no trae el id de la acción del link."
    log error "  Claves disponibles en \$NOTIFICATION: $(printf %s "$notification" | jq -r 'keys | join(", ")')"
    return 1
  fi
  if [[ ! "$action_id" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; then
    log error "api-manager: id de acción del link inválido: '$action_id'."
    return 1
  fi
  printf '%s' "$action_id"
}
fi
