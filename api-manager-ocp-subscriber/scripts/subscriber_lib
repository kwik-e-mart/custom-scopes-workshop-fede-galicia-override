#!/usr/bin/env bash

NP_API_BASE_URL="https://api.nullplatform.com"
SUBSCRIPTION_ID_PATTERN='sub-[a-z0-9]([a-z0-9.-]*[a-z0-9])?--[a-z0-9]([a-z0-9.-]*[a-z0-9])?'
APPROVAL_REF_PATTERN='^RITM[0-9]+$'
PLAN_ID_PATTERN='^[A-Za-z0-9._-]+$'
APIM_DETAIL_MAX_CHARS=300
APIM_CONNECT_TIMEOUT=10
APIM_MAX_TIME=60

if ! type -t mark_settled >/dev/null 2>&1; then
mark_settled() {
  ACTION_SETTLED=1
  if [ -n "${SUBSCRIBER_SETTLED_MARKER-}" ]; then
    printf 1 >"$SUBSCRIBER_SETTLED_MARKER"
  fi
}
fi

if ! type -t update_action >/dev/null 2>&1; then
update_action() {
  local level="$1" message="$2" results="$3"
  shift 3
  local messages
  messages=$(jq -nc --arg l "$level" --arg m "$message" '[{level: $l, message: $m}]')
  local args=(service action update "$@" --messages "$messages")
  if [ -n "$results" ]; then
    args+=(--results "$results")
  fi
  np "${args[@]}"
}
fi

if ! type -t close_action >/dev/null 2>&1; then
close_action() {
  local status="$1" level="info"
  if [ "$status" = "failed" ]; then
    level="error"
  fi
  update_action "$level" "$2" "${3-}" --status "$status" || return 1
  mark_settled
}
fi

if ! type -t report_progress >/dev/null 2>&1; then
report_progress() {
  mark_settled
  update_action info "$1" "${2-}"
}
fi

if ! type -t fail >/dev/null 2>&1; then
fail() {
  log error "$1"
  close_action failed "$1" || log error "subscriber: tampoco se pudo cerrar la acción como fallida."
  exit 1
}
fi

if ! type -t close_on_unexpected_exit >/dev/null 2>&1; then
close_on_unexpected_exit() {
  if [ "${ACTION_SETTLED:-0}" != "1" ]; then
    close_action failed "subscriber: la acción terminó por un error inesperado; revisá el log del agente." || true
  fi
}
fi

if ! type -t require_agent_config >/dev/null 2>&1; then
require_agent_config() {
  local name
  for name in API_SUBSCRIBER_URL API_SUBSCRIBER_TOKEN; do
    if [ -z "${!name-}" ]; then
      fail "subscriber: el agente no tiene configurada la variable $name."
    fi
  done
  if [[ "$API_SUBSCRIBER_URL" != https://* ]]; then
    fail "subscriber: API_SUBSCRIBER_URL tiene que ser https; no se manda el token por un canal sin cifrar."
  fi
}
fi

if ! type -t load_notification >/dev/null 2>&1; then
load_notification() {
  NOTIFICATION=$(printf %s "${NP_ACTION_CONTEXT-}" | jq -c '.notification // empty' 2>/dev/null) || NOTIFICATION=""
  if [ -z "$NOTIFICATION" ]; then
    fail "subscriber: NP_ACTION_CONTEXT no es JSON válido o no trae .notification."
  fi
}
fi

if ! type -t notification_field >/dev/null 2>&1; then
notification_field() {
  printf %s "$NOTIFICATION" | jq -r "$1 // empty"
}
fi

if ! type -t require_action_ids >/dev/null 2>&1; then
require_action_ids() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    fail "subscriber: la notificación no trae service.id o el id de la acción."
  fi
}
fi

if ! type -t require_provider_namespace >/dev/null 2>&1; then
require_provider_namespace() {
  PROVIDER_NAMESPACE=$(printf %s "${CONTEXT-}" | jq -r '.providers["container-orchestration"].cluster.namespace // empty' 2>/dev/null) || PROVIDER_NAMESPACE=""
  if [ -z "$PROVIDER_NAMESPACE" ]; then
    fail "subscriber: el provider container-orchestration no trae cluster.namespace; no se adivina el namespace a suscribir."
  fi
}
fi

if ! type -t require_plan_id_format >/dev/null 2>&1; then
require_plan_id_format() {
  if [[ ! "$1" =~ $PLAN_ID_PATTERN ]]; then
    fail "subscriber: plan_id inválido: '$1'."
  fi
}
fi

if ! type -t callback_url >/dev/null 2>&1; then
callback_url() {
  printf '%s/service/%s/action/%s' "$NP_API_BASE_URL" "$1" "$2"
}
fi

if ! type -t apim_problem_detail >/dev/null 2>&1; then
apim_problem_detail() {
  local body="$1" detail
  detail=$(printf %s "$body" | jq -r '.detail // .title // empty' 2>/dev/null) || detail=""
  if [ -z "$detail" ]; then
    detail="$body"
  fi
  detail=$(printf %s "$detail" | tr -d '\000-\011\013-\037\177')
  printf '%s' "${detail:0:$APIM_DETAIL_MAX_CHARS}"
}
fi

if ! type -t require_subscription_id_format >/dev/null 2>&1; then
require_subscription_id_format() {
  if [[ ! "$1" =~ ^${SUBSCRIPTION_ID_PATTERN}$ ]]; then
    fail "subscriber: subscription_id con formato inválido: '$1'."
  fi
}
fi

if ! type -t apim_request >/dev/null 2>&1; then
apim_request() {
  local method="$1" path="$2" body="${3-}" idempotency_key="${4-}"
  local retries="${APIM_RETRIES:-3}" delay="${APIM_RETRY_DELAY:-5}"
  local attempt=0 response_file code
  response_file=$(mktemp)
  while :; do
    local args=(-sS --config - --connect-timeout "$APIM_CONNECT_TIMEOUT" --max-time "$APIM_MAX_TIME"
      -o "$response_file" -w '%{http_code}' -X "$method" "$API_SUBSCRIBER_URL$path" -H "Accept: application/json")
    if [ -n "$idempotency_key" ]; then
      args+=(-H "Idempotency-Key: $idempotency_key")
    fi
    if [ -n "$body" ]; then
      args+=(-H "Content-Type: application/json" --data-binary "$body")
    fi
    : >"$response_file"
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$API_SUBSCRIBER_TOKEN" | curl "${args[@]}") || code="000"
    APIM_HTTP_CODE="$code"
    APIM_BODY=$(cat "$response_file")
    if [ "$code" != "503" ] && [ "$code" != "000" ]; then
      break
    fi
    if [ "$attempt" -ge "$retries" ]; then
      break
    fi
    attempt=$((attempt + 1))
    log warn "subscriber: APIM no responde (HTTP $code); reintento $attempt de $retries."
    sleep "$delay"
  done
  rm -f "$response_file"
}
fi

if ! type -t lookup_subscription_owner >/dev/null 2>&1; then
lookup_subscription_owner() {
  apim_request GET "/v1/subscriptions/$1" "" ""
  case "$APIM_HTTP_CODE" in
    200)
      SUBSCRIPTION_OWNER=$(printf %s "$APIM_BODY" | jq -r '.consumerNamespace // empty' 2>/dev/null) || SUBSCRIPTION_OWNER=""
      if [ -z "$SUBSCRIPTION_OWNER" ]; then
        fail "subscriber: APIM no informó el namespace de $1; no se toca una suscripción sin saber de quién es."
      fi
      ;;
    404)
      SUBSCRIPTION_OWNER=""
      ;;
    *)
      fail "subscriber: no se pudo verificar la suscripción $1 en APIM (HTTP $APIM_HTTP_CODE): $(apim_problem_detail "$APIM_BODY")"
      ;;
  esac
}
fi

if ! type -t require_owned_by_namespace >/dev/null 2>&1; then
require_owned_by_namespace() {
  if [ "$SUBSCRIPTION_OWNER" != "$2" ]; then
    fail "subscriber: la suscripción $1 es del namespace '$SUBSCRIPTION_OWNER', no de '$2'; no se toca."
  fi
}
fi
