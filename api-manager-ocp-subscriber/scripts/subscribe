#!/usr/bin/env bash
set -euo pipefail

SUBSCRIBE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SUBSCRIBE_DIR/subscriber_lib"

ACTION_SETTLED=0
trap close_on_unexpected_exit EXIT

subscribe() {
  require_agent_config
  load_notification

  local params service_id action_id approval_ref plan_id
  params=$(printf %s "$NOTIFICATION" | jq -c '(.service.attributes // {}) * (.parameters // {})')
  service_id=$(notification_field '.service.id')
  action_id=$(notification_field '.id')
  approval_ref=$(printf %s "$params" | jq -r '.approval_ref // empty')
  plan_id=$(printf %s "$params" | jq -r '.plan_id // empty')

  require_action_ids "$service_id" "$action_id"
  if [ -z "$approval_ref" ] || [ -z "$plan_id" ]; then
    fail "subscriber: faltan approval_ref o plan_id en el pedido."
  fi
  if [[ ! "$approval_ref" =~ $APPROVAL_REF_PATTERN ]]; then
    fail "subscriber: approval_ref inválido: '$approval_ref'. Tiene que ser un número de RITM."
  fi
  require_plan_id_format "$plan_id"
  require_provider_namespace

  local body
  body=$(jq -nc \
    --arg approval_ref "$approval_ref" \
    --arg namespace "$PROVIDER_NAMESPACE" \
    --arg plan_id "$plan_id" \
    --arg callback "$(callback_url "$service_id" "$action_id")" \
    '{approvalRef: $approval_ref, consumerNamespace: $namespace, planId: $plan_id, callbackUrl: $callback}')

  log info "subscriber: pidiendo la suscripción de $PROVIDER_NAMESPACE con $approval_ref y plan $plan_id."
  apim_request POST /v1/subscriptions "$body" "$action_id"

  local results subscription_id operation_id
  case "$APIM_HTTP_CODE" in
    202)
      subscription_id=$(printf %s "$APIM_BODY" | jq -r '.target // empty')
      operation_id=$(printf %s "$APIM_BODY" | jq -r '.id // empty')
      if [[ "$subscription_id" =~ ^${SUBSCRIPTION_ID_PATTERN}$ ]]; then
        results=$(jq -nc --arg sub "$subscription_id" --arg op "$operation_id" --arg ns "$PROVIDER_NAMESPACE" \
          '{subscription_id: $sub, operation_id: $op, consumer_namespace: $ns, owns_subscription: true}')
      else
        log error "subscriber: APIM aceptó el pedido sin un target válido ('$subscription_id'); la instancia no va a poder cambiar el plan ni dar de baja."
        results=$(jq -nc --arg op "$operation_id" --arg ns "$PROVIDER_NAMESPACE" \
          '{operation_id: $op, consumer_namespace: $ns, owns_subscription: false}')
      fi
      report_progress "Suscripción en curso (operación $operation_id). APIM avisa cuando quede activa." "$results" \
        || log error "subscriber: no se pudo guardar el avance; la acción la cierra APIM igual."
      ;;
    409)
      subscription_id=$(apim_problem_detail "$APIM_BODY" | grep -oE "$SUBSCRIPTION_ID_PATTERN" | head -n1 || true)
      results=$(jq -nc --arg ns "$PROVIDER_NAMESPACE" --arg sub "$subscription_id" \
        '{consumer_namespace: $ns, owns_subscription: false} + (if $sub == "" then {} else {subscription_id: $sub} end)')
      close_action success "Tu namespace ya tiene acceso a esta API." "$results"
      ;;
    *)
      fail "subscriber: APIM rechazó la suscripción (HTTP $APIM_HTTP_CODE): $(apim_problem_detail "$APIM_BODY")"
      ;;
  esac
}

subscribe
