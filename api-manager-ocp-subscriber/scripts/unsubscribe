#!/usr/bin/env bash
set -euo pipefail

UNSUBSCRIBE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$UNSUBSCRIBE_DIR/subscriber_lib"

ACTION_SETTLED=0
trap close_on_unexpected_exit EXIT

unsubscribe() {
  load_notification
  request_unsubscription \
    "$(notification_field '.service.attributes.subscription_id')" \
    "$(printf %s "$NOTIFICATION" | jq -r '.service.attributes.owns_subscription // false')" \
    "$(notification_field '.id')"
}

unsubscribe
