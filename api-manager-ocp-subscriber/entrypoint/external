#!/usr/bin/env bash
set -euo pipefail

fail_external() {
  echo "subscriber: $1" >&2
  exit 1
}

for name in API_SUBSCRIBER_URL API_SUBSCRIBER_TOKEN; do
  if [ -z "${!name-}" ]; then
    fail_external "el agente no tiene configurada la variable $name."
  fi
done

context=$(printf %s "${NP_ACTION_CONTEXT-}" | sed "s/^'//;s/'$//")
action=$(printf %s "$context" | jq -r '.notification.action // .action // empty' 2>/dev/null) || action=""
if [ "$action" != "list-apim-plans" ]; then
  fail_external "acción de external context desconocida: '$action'."
fi

response_file=$(mktemp)
trap 'rm -f "$response_file"' EXIT

code=$(curl -sS -o "$response_file" -w '%{http_code}' -X GET "$API_SUBSCRIBER_URL/v1/plans" \
  -H "Authorization: Bearer $API_SUBSCRIBER_TOKEN" -H "Accept: application/json") || code="000"

if [[ ! "$code" =~ ^2 ]]; then
  fail_external "GET /v1/plans respondió HTTP $code: $(cat "$response_file")"
fi

plans=$(jq -ce 'if (.items | type) == "array" then {plans: .items} else error("sin items") end' "$response_file" 2>/dev/null) \
  || fail_external "GET /v1/plans no devolvió una lista de planes en items."

printf '%s\n' "$plans"
