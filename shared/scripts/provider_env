#!/bin/bash
set -euo pipefail

# Downward API field paths supported by Kubernetes for a container env fieldRef.
if ! type -t provider_env_valid_field_ref >/dev/null 2>&1; then
provider_env_valid_field_ref() {
  case "$1" in
    metadata.name|metadata.namespace|metadata.uid) return 0 ;;
    spec.nodeName|spec.serviceAccountName) return 0 ;;
    status.hostIP|status.podIP|status.podIPs) return 0 ;;
    "metadata.labels['"*"']"|"metadata.annotations['"*"']") return 0 ;;
    *) return 1 ;;
  esac
}
fi

# Inner expression of every ${...} placeholder in a value, one per line.
if ! type -t provider_env_ref_placeholders >/dev/null 2>&1; then
provider_env_ref_placeholders() {
  grep -o '\${[^}]*}' <<< "$1" | sed -e 's/^\${//' -e 's/}$//' || true
}
fi

# True when the value has a '${' that no closing brace terminates.
if ! type -t provider_env_ref_unterminated >/dev/null 2>&1; then
provider_env_ref_unterminated() {
  local stripped
  stripped=$(sed -e 's/\${[^}]*}//g' <<< "$1")
  [[ "$stripped" == *'${'* ]]
}
fi

# Value of a context.<path> expression read out of $CONTEXT, JSON-encoded when it
# is an object or array. Returns 1 when the path is absent or null.
if ! type -t provider_env_context_value >/dev/null 2>&1; then
provider_env_context_value() {
  echo "${CONTEXT:-}" | jq -er --arg path "${1#context.}" '
    ($path | split(".") | map(if test("^[0-9]+$") then tonumber else . end)) as $p
    | (try getpath($p) catch null)
    | if . == null then null
      elif type == "object" or type == "array" then tojson
      else tostring end'
}
fi

# Replaces every ${context.<path>} placeholder in a value with its $CONTEXT value,
# leaving the surrounding text and any other placeholder untouched.
if ! type -t provider_env_interpolate_context >/dev/null 2>&1; then
provider_env_interpolate_context() {
  local value="$1" marker='${context.' out="" head expr resolved
  while [[ "$value" == *"$marker"* ]]; do
    head="${value%%"$marker"*}"
    value="${value#*"$marker"}"
    expr="${value%%\}*}"
    value="${value#*\}}"
    resolved=$(provider_env_context_value "context.$expr") || return 1
    out+="$head$resolved"
  done
  printf '%s' "$out$value"
}
fi

if ! type -t provider_env_secret_exists >/dev/null 2>&1; then
provider_env_secret_exists() {
  kubectl get secret "$1" -n "$2" >/dev/null 2>&1
}
fi

if ! type -t provider_env_configmap_exists >/dev/null 2>&1; then
provider_env_configmap_exists() {
  kubectl get configmap "$1" -n "$2" >/dev/null 2>&1
}
fi

if ! type -t provider_env_namespace_for >/dev/null 2>&1; then
provider_env_namespace_for() {
  local ns
  ns=$(yq eval '.metadata.namespace // ""' "$1")
  echo "${ns:-${K8S_NAMESPACE:-default}}"
}
fi

# inject_provider_env <description> <variables_json>
#   variables_json: JSON array of { name, type, value } where type is one of
#   text | ref | secret | configmap. Wires each into the 'application' container
#   env of every $OUTPUT_DIR/deployment-*.yaml, mapping the type to the correct
#   Kubernetes env shape and validating referenced resources exist first.
#   type=ref accepts a Downward API path (metadata.name or ${metadata.name}), a
#   ${context.*} path resolved here from $CONTEXT, and text mixing placeholders
#   (${env.K8S_URL}/pod_info/process_json), left as-is for the engine.
if ! type -t inject_provider_env >/dev/null 2>&1; then
inject_provider_env() {
  local description="$1"
  local variables="$2"

  local deployment_file namespace pod_spec kind app_container
  local sname cname m i count vtype vname vvalue inner resolved bad
  local secret_names configmap_names unknown unique_missing
  local invalid_refs=() missing_context=() missing=()

  # 1. Reject unsupported types up front (case-insensitive; ref == reference).
  unknown=$(echo "$variables" | jq -r '
    .[] | select((.type // "" | ascii_downcase) as $t | ["text","ref","reference","secret","configmap"] | index($t) | not)
        | "\(.name // "?"):\(.type // "null")"')
  if [ -n "$unknown" ]; then
    echo "❌ Cannot inject '$description': unsupported variable type(s):" >&2
    while IFS= read -r m; do echo "   - $m" >&2; done <<< "$unknown"
    echo "💡 Possible causes:" >&2
    echo "   A variable's 'type' is not one of: Text, Reference, Secret, Configmap" >&2
    echo "🔧 How to fix:" >&2
    echo "   • Fix the 'type' field of the offending variable in the provider config" >&2
    exit 1
  fi

  # 2. Resolve type=ref values. A Downward API path — bare or wrapped in a single
  #    ${...} — stays a fieldRef. ${context.*} is interpolated here from $CONTEXT and
  #    the variable becomes a literal. Anything else (text mixed with refs, ${env.*})
  #    is passed through untouched as a literal for the engine to resolve.
  count=$(echo "$variables" | jq 'length')
  for ((i = 0; i < count; i++)); do
    vtype=$(echo "$variables" | jq -r ".[$i].type // \"\" | ascii_downcase")
    if [ "$vtype" != "ref" ] && [ "$vtype" != "reference" ]; then continue; fi

    vname=$(echo "$variables" | jq -r ".[$i].name // \"?\"")
    vvalue=$(echo "$variables" | jq -r ".[$i].value // \"\"")

    if [[ "$vvalue" != *'${'* ]]; then
      if provider_env_valid_field_ref "$vvalue"; then continue; fi
      if [[ "$vvalue" != context.* ]]; then
        invalid_refs+=("$vname: $vvalue")
        continue
      fi
      if ! resolved=$(provider_env_context_value "$vvalue"); then
        missing_context+=("$vname: $vvalue")
        continue
      fi
      variables=$(echo "$variables" | jq -c --argjson idx "$i" --arg v "$resolved" '.[$idx] |= (.type = "text" | .value = $v)')
      continue
    fi

    if provider_env_ref_unterminated "$vvalue"; then
      invalid_refs+=("$vname: $vvalue (unterminated \${...})")
      continue
    fi

    bad=0
    while IFS= read -r inner; do
      [ -n "$inner" ] || continue
      case "$inner" in
        env.*) continue ;;
        context.*)
          if ! provider_env_context_value "$inner" >/dev/null; then
            missing_context+=("$vname: \${$inner}")
            bad=1
          fi
          continue
          ;;
      esac
      if ! provider_env_valid_field_ref "$inner"; then
        invalid_refs+=("$vname: \${$inner}")
        bad=1
      fi
    done < <(provider_env_ref_placeholders "$vvalue")
    if [ "$bad" -ne 0 ]; then continue; fi

    if [[ "$vvalue" =~ ^\$\{(.+)\}$ ]] && provider_env_valid_field_ref "${BASH_REMATCH[1]}"; then
      variables=$(echo "$variables" | jq -c --argjson idx "$i" --arg v "${BASH_REMATCH[1]}" '.[$idx].value = $v')
      continue
    fi

    resolved=$(provider_env_interpolate_context "$vvalue")
    variables=$(echo "$variables" | jq -c --argjson idx "$i" --arg v "$resolved" '.[$idx] |= (.type = "text" | .value = $v)')
  done

  if [ "${#invalid_refs[@]}" -gt 0 ]; then
    echo "❌ Cannot inject '$description': unsupported reference(s) for type=ref:" >&2
    for m in "${invalid_refs[@]}"; do echo "   - $m" >&2; done
    echo "💡 Possible causes:" >&2
    echo "   A type=ref 'value' is neither a Downward API field path, a context path," >&2
    echo "   nor a \${env.*} placeholder" >&2
    echo "🔧 How to fix:" >&2
    echo "   • Downward API path, bare or wrapped: metadata.name or \${metadata.name}." >&2
    echo "     One of: metadata.name, metadata.namespace, metadata.uid," >&2
    echo "     metadata.labels['KEY'], metadata.annotations['KEY']," >&2
    echo "     spec.nodeName, spec.serviceAccountName, status.hostIP, status.podIP, status.podIPs" >&2
    echo "   • Deployment context path: context.release.build_id or \${context.release.build_id}" >&2
    echo "   • Text mixed with placeholders: \${env.K8S_URL}/pod_info/process_json" >&2
    exit 1
  fi

  if [ "${#missing_context[@]}" -gt 0 ]; then
    echo "❌ Cannot inject '$description': context reference(s) not found in \$CONTEXT:" >&2
    for m in "${missing_context[@]}"; do echo "   - $m" >&2; done
    echo "💡 Possible causes:" >&2
    echo "   The path does not exist in the deployment context, or it is added by a step" >&2
    echo "   that runs after this one" >&2
    echo "🔧 How to fix:" >&2
    echo "   • Available top-level keys: $(echo "${CONTEXT:-{\}}" | jq -r 'try (keys | join(", ")) catch "<invalid CONTEXT>"')" >&2
    echo "   • Inspect a subtree: echo \"\$CONTEXT\" | jq .release" >&2
    exit 1
  fi

  # 3. Validate secret/configmap resources exist in each deployment's namespace.
  secret_names=$(echo "$variables" | jq -r '.[] | select((.type | ascii_downcase) == "secret") | .value')
  configmap_names=$(echo "$variables" | jq -r '.[] | select((.type | ascii_downcase) == "configmap") | .value')
  for deployment_file in "$OUTPUT_DIR"/deployment-*.yaml; do
    [ -f "$deployment_file" ] || continue
    namespace=$(provider_env_namespace_for "$deployment_file")
    while IFS= read -r sname; do
      [ -n "$sname" ] || continue
      provider_env_secret_exists "$sname" "$namespace" || missing+=("secret $namespace/$sname")
    done <<< "$secret_names"
    while IFS= read -r cname; do
      [ -n "$cname" ] || continue
      provider_env_configmap_exists "$cname" "$namespace" || missing+=("configmap $namespace/$cname")
    done <<< "$configmap_names"
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    unique_missing=$(printf '%s\n' "${missing[@]}" | sort -u)
    echo "❌ Cannot inject '$description': referenced resources do not exist in the cluster:" >&2
    while IFS= read -r m; do echo "   - $m" >&2; done <<< "$unique_missing"
    echo "💡 Possible causes:" >&2
    echo "   The Secret/ConfigMap named in a variable's 'value' is missing from its namespace" >&2
    echo "🔧 How to fix:" >&2
    echo "   • List secrets:    kubectl get secret -n <namespace>" >&2
    echo "   • List configmaps: kubectl get configmap -n <namespace>" >&2
    exit 1
  fi

  # 4. Build the Kubernetes env entries, one shape per type.
  PROVIDER_ENV_ENTRIES=$(echo "$variables" | jq -c '
    [ .[] | (.type | ascii_downcase) as $t |
      if   $t == "text"                        then { name, value: (.value // "") }
      elif $t == "ref" or $t == "reference"    then { name, valueFrom: { fieldRef:        { fieldPath: .value } } }
      elif $t == "secret"                      then { name, valueFrom: { secretKeyRef:    { name: .value, key: .name } } }
      else                                          { name, valueFrom: { configMapKeyRef: { name: .value, key: .name } } }
      end ]')
  export PROVIDER_ENV_ENTRIES

  # 5. Merge into the 'application' container env of every deployment file.
  for deployment_file in "$OUTPUT_DIR"/deployment-*.yaml; do
    [ -f "$deployment_file" ] || continue
    kind=$(yq eval '.kind' "$deployment_file")
    echo "📝 Injecting $description env into $deployment_file (kind: $kind)"

    if [ "$kind" = "CronJob" ]; then
      pod_spec=".spec.jobTemplate.spec.template.spec"
    else
      pod_spec=".spec.template.spec"
    fi

    app_container=$(yq eval "${pod_spec}.containers[] | select(.name == \"application\") | .name" "$deployment_file")
    if [ -z "$app_container" ]; then
      echo "❌ No container named 'application' found in $deployment_file (kind: $kind)" >&2
      echo "🔧 Inspect containers: yq eval '${pod_spec}.containers[].name' $deployment_file" >&2
      exit 1
    fi

    # Existing env wins on name collision (existing entries come first in the concat).
    yq eval -i "(${pod_spec}.containers[] | select(.name == \"application\") | .env) |= ((. // []) + env(PROVIDER_ENV_ENTRIES) | unique_by(.name))" "$deployment_file"

    echo "✅ Injected $(echo "$PROVIDER_ENV_ENTRIES" | jq 'length') env var(s) into container 'application' in $deployment_file"
  done
}
fi
