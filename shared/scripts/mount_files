#!/bin/bash
set -euo pipefail

if ! type -t mount_files_secret_exists >/dev/null 2>&1; then
mount_files_secret_exists() {
  kubectl get secret "$1" -n "$2" >/dev/null 2>&1
}
fi

if ! type -t mount_files_namespace_for >/dev/null 2>&1; then
mount_files_namespace_for() {
  local ns
  ns=$(yq eval '.metadata.namespace // ""' "$1")
  echo "${ns:-${K8S_NAMESPACE:-default}}"
}
fi

if ! type -t mount_files >/dev/null 2>&1; then
mount_files() {
  local description="$1"
  local mounts="$2"

  local deployment_file kind pod_spec app_container namespace secret_name m
  local secret_names unique_missing missing=()

  MOUNT_FILES_VOLUMES=$(echo "$mounts" | yq -o=json -I=0 '[.[] | {"name": .name, "secret": {"secretName": .secretName, "defaultMode": .mode}}]')
  export MOUNT_FILES_VOLUMES
  MOUNT_FILES_VOLUME_MOUNTS=$(echo "$mounts" | yq -o=json -I=0 '[.[] | {"name": .name, "readOnly": .readOnly, "mountPath": .path}]')
  export MOUNT_FILES_VOLUME_MOUNTS

  secret_names=$(echo "$mounts" | yq eval '.[] | select(.secretName) | .secretName')

  for deployment_file in "$OUTPUT_DIR"/deployment-*.yaml; do
    [ -f "$deployment_file" ] || continue
    namespace=$(mount_files_namespace_for "$deployment_file")
    while IFS= read -r secret_name; do
      [ -n "$secret_name" ] || continue
      if ! mount_files_secret_exists "$secret_name" "$namespace"; then
        missing+=("$namespace/$secret_name")
      fi
    done <<< "$secret_names"
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    unique_missing=$(printf '%s\n' "${missing[@]}" | sort -u)
    echo "❌ Cannot mount '$description': the following secrets do not exist in the cluster:" >&2
    while IFS= read -r m; do echo "   - $m" >&2; done <<< "$unique_missing"
    echo "🔧 Create the missing secrets, then retry: kubectl get secret -n <namespace>" >&2
    exit 1
  fi

  for deployment_file in "$OUTPUT_DIR"/deployment-*.yaml; do
    if [ -f "$deployment_file" ]; then
      kind=$(yq eval '.kind' "$deployment_file")
      echo "📝 Mounting $description into $deployment_file (kind: $kind)"

      if [ "$kind" = "CronJob" ]; then
        pod_spec=".spec.jobTemplate.spec.template.spec"
      else
        pod_spec=".spec.template.spec"
      fi

      app_container=$(yq eval "${pod_spec}.containers[] | select(.name == \"application\") | .name" "$deployment_file")
      if [ -z "$app_container" ]; then
        echo "❌ No container named 'application' found in $deployment_file (kind: $kind)" >&2
        echo "🔧 Inspect containers: yq eval '${pod_spec}.containers[].name' $deployment_file" >&2
        exit 1
      fi

      yq eval -i "${pod_spec}.volumes |= ((. // []) + env(MOUNT_FILES_VOLUMES) | unique_by(.name))" "$deployment_file"
      yq eval -i "(${pod_spec}.containers[] | select(.name == \"application\") | .volumeMounts) |= ((. // []) + env(MOUNT_FILES_VOLUME_MOUNTS) | unique_by(.name))" "$deployment_file"

      echo "✅ Added ${pod_spec}.volumes and mounts on container 'application' in $deployment_file"
    fi
  done
}
fi
